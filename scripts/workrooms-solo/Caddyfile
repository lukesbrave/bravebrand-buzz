{
	admin off
	auto_https off
}

# HTTPS with the certificate setup.mjs made on this Mac. compose.solo.yml
# publishes this port on the Mac's loopback address only.
:8443 {
	tls /certs/workspace.crt /certs/workspace.key
	encode zstd gzip
	@private path /admin /admin/* /api/admin /api/admin/* /api/v1/admin /api/v1/admin/* /operator /operator/* /metrics /health /_readiness /_liveness /_mesh/* /debug /debug/*
	handle @private {
		respond 404
	}
	handle {
		reverse_proxy relay:3000
	}
}
