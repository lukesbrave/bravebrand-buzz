{
  "$schema": "https://schema.tauri.app/config/2",
  "identifier": "com.bravebrand.digitalhome.workrooms",
  "productName": "Digital Home Workrooms",
  "build": {
    "features": ["bravebrand-workrooms"]
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": ["workrooms"]
      }
    }
  },
  "bundle": {
    "macOS": {
